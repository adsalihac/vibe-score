generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Investigation {
  id           String   @id @default(cuid())
  repoFullName String
  caseId       String
  payload      Json
  createdAt    DateTime @default(now())

  @@index([repoFullName])
}
